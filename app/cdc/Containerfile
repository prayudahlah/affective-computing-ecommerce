FROM docker.io/eclipse-temurin:21-jre

ARG DEBEZIUM_VERSION=3.4.2.Final

LABEL description="Debezium Cassandra CDC Connector (Standalone)"
LABEL version="${DEBEZIUM_VERSION}"

RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
  "https://repo1.maven.org/maven2/io/debezium/debezium-connector-cassandra-5/${DEBEZIUM_VERSION}/debezium-connector-cassandra-5-${DEBEZIUM_VERSION}-jar-with-dependencies.jar" \
  -o /debezium-connector-cassandra.jar

WORKDIR /opt/debezium

VOLUME ["/cdc_raw", "/config"]
ENTRYPOINT ["java", "-Xmx512m", "--add-opens", "java.base/java.nio=ALL-UNNAMED", "--add-opens", "java.base/sun.nio.ch=ALL-UNNAMED", "-jar", "/debezium-connector-cassandra.jar"]

CMD ["/config/config.properties"]
